#: freestep/gui/texts.py
msgid "FreeSTEP does not store the eye condition; the first acquisition is taken as eyes closed (as set)."
msgstr "FreeSTEP neukládá, zda měl proband oči otevřené; první záznam je podle nastavení se zavřenýma očima."

#: freestep/gui/texts.py
msgid "ML = medio-lateral direction (left–right, x axis of the plate), AP = antero-posterior direction (forward–backward, y axis of the plate)."
msgstr "ML = medio-laterální směr (vlevo–vpravo, osa x plošiny), AP = antero-posteriorní směr (vpřed–vzad, osa y plošiny)."

